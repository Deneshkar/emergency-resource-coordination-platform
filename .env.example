# Emergency Resource Coordination Platform
# Example Environment Configuration

# Backend JWT Authentication
Jwt__SecretKey=YOUR_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
Jwt__Issuer=ERCP.Api
Jwt__Audience=ERCP.Clients

# PostgreSQL Database (Optional - defaults to in-memory if not provided/fails)
ConnectionStrings__DefaultConnection=Host=localhost;Database=ercp_db;Username=postgres;Password=YOUR_PASSWORD

# AI Agent Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# WhatsApp Cloud API Notifications
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_DEFAULT_RECIPIENT=94711759718

